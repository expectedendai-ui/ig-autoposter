{
  "name": "ig-autoposter",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  // Runs every hour on the hour. A failed hour is simply retried the next hour.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Create it with: npx wrangler kv namespace create KV   (then paste the id here)
    { "binding": "KV", "id": "PASTE_YOUR_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "GITHUB_REPO": "your-user/your-repo",   // the repo holding images/ and manifest.json (must be public)
    "GITHUB_BRANCH": "main",
    "TIMEZONE": "America/New_York",
    "CADENCE_DAYS": "1,3,5",                // 0=Sun … 6=Sat. Mon, Wed, Fri by default
    "CADENCE_HOUR": "15"                    // local hour posts go out (15 = 3pm)
  }
}
